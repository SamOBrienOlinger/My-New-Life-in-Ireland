{
  "extends": "./tsconfig.json",
  "compilerOptions": { "incremental": false },
  "include": [
    "app/**/*.ts", "app/**/*.tsx",
    "components/**/*.ts", "components/**/*.tsx",
    "hooks/**/*.ts", "lib/**/*.ts",
    "github-pages/**/*.tsx", "vite.pages.config.ts",
    "playwright.config.ts", "tests/browser/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
